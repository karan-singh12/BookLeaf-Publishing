{
  "name": "bookleaf-publishing-backend",
  "version": "1.0.0",
  "description": "REST API, AI SDK and realtime layer for the BookLeaf Author Support & Communication Portal",
  "main": "dist/server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed": "tsx src/scripts/seed.ts",
    "seed:reset": "tsx src/scripts/seed.ts --reset",
    "ai:check": "tsx src/scripts/ai-check.ts",
    "db:status": "tsx src/scripts/db-status.ts",
    "db:sync-indexes": "tsx src/scripts/sync-indexes.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "ai:cost": "tsx src/scripts/ai-cost.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.3.0",
    "joi": "^18.2.8",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.5",
    "morgan": "^1.10.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.0.0",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
