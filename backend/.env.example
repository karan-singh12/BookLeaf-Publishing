# --- Server ---
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed browser origins (the deployed frontend URL in production)
CORS_ORIGIN=http://localhost:3000

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/bookleaf

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h

# --- AI (Google Gemini). Leave GEMINI_API_KEY empty to run in degraded/manual mode ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
AI_TIMEOUT_MS=12000

# --- Fallback AI providers (router tries each in priority order) ---
GROK_API_KEY=
GROK_MODEL=grok-2-latest
GROK_BASE_URL=https://api.x.ai/v1

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- AI routing: ordered fallback chain (Gemini -> Grok -> OpenRouter) ---
AI_ROUTE_DEFAULT=gemini,grok,openrouter
AI_ROUTE_CLASSIFY=gemini,grok,openrouter
AI_ROUTE_DRAFT=gemini,grok,openrouter
AI_RETRIES=1
AI_MAX_CONCURRENT=4
AI_MAX_QUEUED=50

# 0 disables Gemini 2.5 Flash "thinking" (keeps answers short and uncut). -1 = model default.
GEMINI_THINKING_BUDGET=0
