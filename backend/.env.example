# --- Server ---
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed browser origins (the deployed frontend URL in production)
CORS_ORIGIN=http://localhost:3000

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/bookleaf

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h

# --- AI (Google Gemini). Leave GEMINI_API_KEY empty to run in degraded/manual mode ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
AI_TIMEOUT_MS=12000

# --- Optional extra AI providers (the router falls back to any configured one) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# --- AI routing: ordered fallback chains, "provider:model,provider:model" ---
# Unset = try every configured provider in priority order (gemini, openai, anthropic, openrouter).
AI_ROUTE_DEFAULT=
AI_ROUTE_CLASSIFY=
AI_ROUTE_DRAFT=
AI_RETRIES=1
AI_MAX_CONCURRENT=4
AI_MAX_QUEUED=50

# 0 disables Gemini 2.5 Flash "thinking" (keeps answers short and uncut). -1 = model default.
GEMINI_THINKING_BUDGET=0
